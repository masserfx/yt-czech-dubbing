{
  "manifest_version": 3,
  "name": "YouTube Dubbing — CS SK PL HU",
  "version": "2.4.1",
  "description": "YouTube video dubbing - automatic translation and voice output in Czech, Slovak, Polish, Hungarian",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel",
    "offscreen",
    "declarativeNetRequest"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/live-translate.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://api.mymemory.translated.net/*",
    "https://libretranslate.de/*",
    "https://translate.argosopentech.com/*",
    "https://translate.terraprint.co/*",
    "https://translate.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://*.tts.speech.microsoft.com/*",
    "https://*.api.cognitive.microsoft.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "wss://speech.platform.bing.com/*",
    "https://speech.platform.bing.com/*",
    "https://api.voicedub.ai/*",
    "https://*.workers.dev/*",
    "http://127.0.0.1:8000/*",
    "https://feeds.bbci.co.uk/*",
    "https://feeds.npr.org/*",
    "https://feeds.bloomberg.com/*",
    "https://feeds.feedburner.com/*",
    "https://feeds.arstechnica.com/*",
    "https://www.theguardian.com/*",
    "https://www.aljazeera.com/*",
    "https://techcrunch.com/*",
    "https://www.theverge.com/*",
    "https://www.wired.com/*",
    "https://hnrss.org/*",
    "https://www.technologyreview.com/*",
    "https://venturebeat.com/*",
    "https://deepmind.google/*",
    "https://openai.com/*",
    "https://www.anthropic.com/*",
    "https://export.arxiv.org/*",
    "https://huggingface.co/*",
    "https://www.lupa.cz/*",
    "https://www.root.cz/*",
    "https://www.zive.cz/*",
    "https://ct24.ceskatelevize.cz/*",
    "https://www.seznamzpravy.cz/*",
    "https://www.aktualne.cz/*",
    "https://www.novinky.cz/*",
    "https://www.irozhlas.cz/*",
    "https://www.coindesk.com/*",
    "https://cointelegraph.com/*",
    "https://decrypt.co/*",
    "https://www.nature.com/*",
    "https://www.sciencedaily.com/*",
    "https://api.quantamagazine.org/*",
    "https://www.newscientist.com/*",
    "https://www.nasa.gov/*",
    "https://www.space.com/*",
    "https://www.esa.int/*",
    "https://www.polygon.com/*",
    "https://www.eurogamer.net/*",
    "https://www.pcgamer.com/*",
    "https://www.espn.com/*",
    "https://rss.nytimes.com/*",
    "https://www.statnews.com/*",
    "https://www.newyorker.com/*",
    "https://www.carbonbrief.org/*",
    "https://insideclimatenews.org/*",
    "https://grist.org/*",
    "https://sifted.eu/*",
    "https://www.ycombinator.com/*",
    "https://krebsonsecurity.com/*",
    "https://www.bleepingcomputer.com/*",
    "https://www.reutersagency.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "src/page-script.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "src/caption-extractor.js",
        "src/language-config.js",
        "src/speaker-detector.js",
        "src/service-mode.js",
        "src/voicedub-client.js",
        "src/realtime-translate-client.js",
        "src/glossary.js",
        "src/translator.js",
        "src/tts-engine.js",
        "src/dubbing-cache.js",
        "src/dubbing-controller.js",
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 https://*;"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "edge_tts_headers",
        "enabled": true,
        "path": "rules/edge-tts-headers.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
